import { describe, it, expect, vi, beforeEach } from 'vitest'

// Tests D and E from the task #187 spec, for both routes that wire in the
// sensitive-content gate:
//   D. When checkSensitiveContent flags a message, noraChat is never called
//      and updateNoraMemory is never called — the disclosure never reaches
//      generation or the notes/claims pipeline.
//   E. A normal (unflagged) message still runs the ordinary
//      noraChat -> updateNoraMemory path unchanged.
//
// This isolates each route's own control flow (the thing task #187 actually
// changed) rather than re-testing the libraries it calls into, which
// already have their own coverage (tests/safety.test.js for the classifier
// itself, tests/notes-history.test.js and tests/privacy-boundary.test.js for
// lib/nora-memory.js). Every import each route makes is mocked at the
// module boundary — the lightest reliable strategy for exercising real
// route handlers without a test-DB project.

const state = vi.hoisted(() => ({
  safetyResult: { flagged: false, category: null, ok: true },
  tableResponses: {},
}))

function resetState() {
  state.safetyResult = { flagged: false, category: null, ok: true }
  state.tableResponses = {
    ai_conversations: { data: { user_id: 'u1', couple_id: 'c1', type: 'shared', pending_surfaced_claim_ids: null }, error: null },
    ai_messages: { data: { id: 'msg1', role: 'assistant', content: 'resp' }, error: null },
    ai_usage: { data: { message_count: 1 }, error: null },
    couples: { data: { user1_id: 'u1', user2_id: 'u2' }, error: null },
    user_profiles: { data: { user_id: 'u1', display_name: 'Matt', is_premium: false }, error: null },
  }
}

// Generic thenable + chainable query-builder stub. Every filter method
// returns the same handler; .maybeSingle()/.single()/awaiting the chain
// directly all resolve to the configured response for that table.
function chain(table) {
  const resolveValue = () => state.tableResponses[table] || { data: null, error: null }
  const promise = Promise.resolve().then(resolveValue)
  const handler = {
    select: () => handler,
    eq: () => handler,
    in: () => handler,
    order: () => handler,
    limit: () => handler,
    is: () => handler,
    not: () => handler,
    gt: () => handler,
    lt: () => handler,
    insert: () => handler,
    update: () => handler,
    upsert: () => handler,
    maybeSingle: () => promise,
    single: () => promise,
    then: (res, rej) => promise.then(res, rej),
    catch: (rej) => promise.catch(rej),
  }
  return handler
}

function makeSupabase() {
  return { from: (table) => chain(table) }
}

vi.mock('next/server', () => ({
  NextResponse: { json: (body, init) => ({ body, status: init?.status ?? 200 }) },
