  getFullNoraContext: vi.fn(async () => ({ noraBriefing: '' })),
  updateNoraMemory: vi.fn(async () => {}),
  maybeUpdateNoraMemory: vi.fn(async () => {}),
  shouldUpdateMemory: vi.fn(async () => true),
  getMemoryBriefing: vi.fn(() => ''),
  getSurfaceableClaims: vi.fn(async () => ({ promptBlock: '', surfacedClaimIds: [] })),
  classifyClaimResponse: vi.fn(async () => {}),
