vi.mock('@/lib/ai-coach-context', () => ({
  buildCoachContext: vi.fn(async () => ({ user: { name: 'Matt' }, partner: { name: 'Cass' } })),
  formatContextForPrompt: vi.fn(() => ''),
  getRecentActivity: vi.fn(() => null),
  getConversationHistory: vi.fn(async () => []),
}))

const { noraChat } = await import('@/lib/nora')
const { updateNoraMemory } = await import('@/lib/nora-memory')
const { POST: aiCoachPOST } = await import('@/app/api/ai-coach/route.js')
const { POST: couplesSessionPOST } = await import('@/app/api/couples-session/route.js')

function makeRequest(body) {
  return {
    headers: { get: (name) => (name.toLowerCase() === 'authorization' ? 'Bearer faketoken' : null) },
    json: async () => body,
  }
}

describe('sensitive-content gate — ai-coach route', () => {
  beforeEach(() => {
    resetState()
    vi.clearAllMocks()
  })

  it('D: flagged input skips noraChat and updateNoraMemory', async () => {
    state.safetyResult = { flagged: true, category: 'SELF_HARM', ok: true }
    const res = await aiCoachPOST(makeRequest({
      message: 'a sensitive disclosure',
      conversationId: 'conv1',
      coupleId: 'c1',
    }))
    expect(noraChat).not.toHaveBeenCalled()
    expect(updateNoraMemory).not.toHaveBeenCalled()
    expect(res.body.message.content).toBe('FIXED_SAFETY_RESPONSE')
  })

  it('E: normal input still runs noraChat -> updateNoraMemory', async () => {
    state.safetyResult = { flagged: false, category: null, ok: true }
    await aiCoachPOST(makeRequest({
      message: 'just a normal message',
      conversationId: 'conv1',
      coupleId: 'c1',
    }))
    expect(noraChat).toHaveBeenCalled()
    expect(updateNoraMemory).toHaveBeenCalled()
  })

  it('classifier error (ok: false) still generates a response but skips the memory write', async () => {
    state.safetyResult = { flagged: false, category: null, ok: false }
    await aiCoachPOST(makeRequest({
      message: 'a message the classifier could not evaluate',
      conversationId: 'conv1',
      coupleId: 'c1',
    }))
    expect(noraChat).toHaveBeenCalled()
    expect(updateNoraMemory).not.toHaveBeenCalled()
  })
})

